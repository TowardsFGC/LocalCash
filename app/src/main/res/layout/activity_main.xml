<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocalCash"
            android:textColor="#145A46"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TUS FINANZAS BAJO TU CONTROL"
            android:textColor="#648076"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginTop="28dp"
            android:background="#28A879" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="¡Bienvenid@!"
            android:textColor="#193C32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Organiza tus cuentas, registra tus gastos y planifica tus compras desde un solo lugar."
            android:textColor="#61746C"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnHuella"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="#197653"
            android:text="Desbloquear con huella"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Tu información financiera permanece en tu dispositivo."
            android:textColor="#71847B"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
